# Copia este archivo como .env y rellena los valores.

# Datos del titular que aparecen en /privacidad (obligatorios al publicar la web)
CTE_TITULAR=
CTE_NIF=
CTE_DOMICILIO=
CTE_EMAIL=
CTE_ALOJAMIENTO=
# Solo si el titular está inscrito en un registro (p. ej. sociedades):
# CTE_REGISTRO=Registro Mercantil de Madrid, tomo …, folio …, hoja …

# Opcionales
# PORT=3000
# HOST=127.0.0.1                  # 0.0.0.0 para atender desde otros equipos
# CTE_PROXY=1                     # detrás de un proxy inverso (nº de saltos)
# CTE_BUSQUEDAS_MINUTO=120        # búsquedas por IP y minuto
